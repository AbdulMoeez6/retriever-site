---
// Pinwheel page header: breadcrumb pill, title and intro. The default slot renders above the title.
import { markdownify } from "@/lib/utils/textConverter";

export interface Props {
  title: string;
  content?: string;
}

const { title, content } = Astro.props;
---

<div class="text-center">
  <nav aria-label="Breadcrumb">
    <ol class="breadcrumb inline-flex h-8 items-center justify-center space-x-2 rounded-3xl bg-light px-4 py-2">
      <li class="leading-none text-text-dark">
        <a href="/" class="inline-flex items-center text-primary">
          <svg class="mr-1.5" width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M13.1769 15.0588H10.3533V9.41178H5.64744V15.0588H2.82391V6.58825H1.88274V16H14.118V6.58825H13.1769V15.0588ZM6.58862 15.0588V10.353H9.41215V15.0588H6.58862ZM15.8084 6.09225L15.2512 6.85178L8.00038 1.52472L0.749559 6.8499L0.192383 6.09131L8.00038 0.357666L15.8084 6.09225Z"
              fill="currentColor"></path>
          </svg>
          <span class="text-sm leading-none">Home</span>
        </a>
      </li>
      <li class="leading-none text-text-dark" aria-current="page">
        <span class="text-sm leading-none">/ {title}</span>
      </li>
    </ol>
  </nav>
  <slot />
  <h1 class="mb-5 mt-6 tracking-tight">{title}</h1>
  {content && <p class="mx-auto max-w-2xl" set:html={markdownify(content)} />}
</div>
