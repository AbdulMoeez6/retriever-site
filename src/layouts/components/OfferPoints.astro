---
// Check-mark list under an offer heading (from the original Book a demo page).
export interface Props {
  points: string[];
}

const { points } = Astro.props;
---

<ul class="bd-rise mt-10 grid gap-3 text-sm text-slate-400" style="--d: 210ms">
  {
    points.map((point) => (
      <li class="flex items-center gap-3">
        <span class="grid size-5 place-items-center rounded-full bg-white/[0.06] ring-1 ring-white/10">
          <svg
            viewBox="0 0 24 24"
            class="size-3 text-[#9CC0EA]"
            fill="none"
            stroke="currentColor"
            stroke-width="2.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m5 12 4.5 4.5L19 7" />
          </svg>
        </span>
        {point}
      </li>
    ))
  }
</ul>
