---
// Light/dark toggle. Behaviour is wired in scripts/site.js via [data-theme-toggle].
const { class: className = "" } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  class:list={[
    "grid size-9 place-items-center rounded-md text-text transition-colors hover:bg-light hover:text-text-dark",
    className,
  ]}
  aria-label="Toggle colour theme"
>
  <!-- moon (shown in light mode) -->
  <svg class="size-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
    <path d="M16.8 13.2A6.3 6.3 0 0 1 10.4 5 7 7 0 1 0 19 14.6a6.2 6.2 0 0 1-2.2-1.4z"></path>
  </svg>
  <!-- sun (shown in dark mode) -->
  <svg class="hidden size-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
    <circle cx="12" cy="12" r="3.4"></circle>
    <path
      d="M12 3v1.8M12 19.2V21M4.9 4.9l1.3 1.3M17.8 17.8l1.3 1.3M3 12h1.8M19.2 12H21M4.9 19.1l1.3-1.3M17.8 6.2l1.3-1.3"
    ></path>
  </svg>
</button>
