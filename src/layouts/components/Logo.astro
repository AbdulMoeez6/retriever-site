---
// Retriever wordmark: round logo mark + name (from the original site's header).
import config from "@/config/config.json";

export interface Props {
  size?: number;
  class?: string;
  link?: boolean;
}

const { size = 32, class: className = "", link = true } = Astro.props;
const Tag = link ? "a" : "span";
---

<Tag
  href={link ? "/" : undefined}
  aria-label={link ? `${config.site.logo_text} home` : undefined}
  class:list={["navbar-brand inline-flex items-center gap-2.5 rounded-md font-semibold tracking-tight", className]}
>
  <img
    src={config.site.logo}
    alt=""
    width={size}
    height={size}
    class="shrink-0 rounded-full object-cover"
    style={`width:${size}px;height:${size}px`}
  />
  <span>{config.site.logo_text}</span>
</Tag>
