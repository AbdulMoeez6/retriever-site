---
// Marketing layout: Pinwheel's Base (head, header, main, footer) with Retriever branding.
import TwSizeIndicator from "@/components/TwSizeIndicator.astro";
import Footer from "@/partials/Footer.astro";
import Head from "@/partials/Head.astro";
import Header from "@/partials/Header.astro";

export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
}
---

<!doctype html>
<html lang="en">
  <head>
    <Head {...Astro.props} />
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only z-[90] rounded-md bg-white px-4 py-2 text-text-dark focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
      >Skip to content</a
    >
    <TwSizeIndicator />
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script>
      import "@/scripts/site.js";
    </script>
  </body>
</html>
