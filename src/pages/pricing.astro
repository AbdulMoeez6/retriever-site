---
import { withBase } from "@/lib/utils/url";
import PageHeader from "@/components/PageHeader.astro";
import PricingCard from "@/components/PricingCard.astro";
import Base from "@/layouts/Base.astro";
import { getEntry } from "astro:content";

const pricing = await getEntry("pricing", "-index");
if (!pricing) throw new Error("Missing pricing content");
const data = pricing.data;
---

<Base title={data.title} meta_title={data.meta_title} description={data.description}>
  <div class="relative isolate overflow-hidden">
    <div class="aurora aurora-soft"></div>
    <div class="dotgrid pointer-events-none absolute inset-0 opacity-60"></div>

    <section class="page-hero relative pb-10 pt-16">
      <div class="container">
        <PageHeader title={data.title} content={data.description}>
          <p
            class="mt-6 inline-flex items-center rounded-full border border-amber-300 bg-amber-50 px-3 py-1 text-xs font-medium text-amber-900 dark:border-amber-700/60 dark:bg-amber-500/10 dark:text-amber-200"
          >
            {data.badge}
          </p>
        </PageHeader>

        <!-- billing period toggle -->
        <div class="mt-8 flex justify-center">
          <div
            class="pricing-toggle rounded-lg border border-border bg-light p-1 dark:bg-white/5"
            role="group"
            aria-label="Billing period"
          >
            <span class="pricing-pill" data-pos="monthly" aria-hidden="true"></span>
            <button type="button" class="pricing-opt rounded-md px-3 py-1.5 text-sm" data-period="monthly" aria-pressed="true">
              Monthly
            </button>
            <button type="button" class="pricing-opt rounded-md px-3 py-1.5 text-sm" data-period="annual" aria-pressed="false">
              Annual
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- pricing cards -->
    <section class="section relative pt-4">
      <div class="container">
        <div class="row gy-4">
          {
            data.pricing_card.map((item) => (
              <div class="mt-6 md:col-6 xl:col-3">
                <PricingCard item={item} toast={data.contact_toast} />
              </div>
            ))
          }
        </div>

        <!-- Founding Partner Pilot -->
        <section class="card mt-12 p-6 sm:p-8" aria-labelledby="pilot-title">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div class="flex flex-wrap items-center gap-2">
              <h2 id="pilot-title" class="h4">{data.pilot.title}</h2>
              <span
                class="rounded-full border border-navy/30 bg-navy/5 px-2.5 py-0.5 text-[11px] font-medium text-navy dark:border-slate-500 dark:bg-white/5 dark:text-slate-200"
              >
                {data.pilot.badge}
              </span>
            </div>
            <div class="text-left sm:text-right">
              <div class="text-3xl font-semibold tracking-tight text-text-dark">{data.pilot.price}</div>
              <div class="mt-1 text-sm">{data.pilot.unit}</div>
            </div>
          </div>
          <dl class="mt-5 grid gap-4 sm:grid-cols-3">
            {
              data.pilot.details.map((detail) => (
                <div>
                  <dt class="text-xs uppercase tracking-wide">{detail.label}</dt>
                  <dd class="mt-1 text-sm font-medium text-text-dark">{detail.value}</dd>
                </div>
              ))
            }
          </dl>
          <a class="btn btn-primary btn-sm mt-6" href={withBase(data.pilot.button.link)}>{data.pilot.button.label}</a>
        </section>

        <p class="mt-8 text-center text-xs">{data.disclaimer}</p>
      </div>
    </section>
  </div>
</Base>

<script>
  import "@/scripts/pricing.js";
</script>
