---
import VideoShowcase from "@/components/VideoShowcase.astro";
import Base from "@/layouts/Base.astro";
import DashboardPreview from "@/layouts/function-components/DashboardPreview.jsx";
import QuickAssessmentLauncher from "@/layouts/function-components/QuickAssessmentLauncher.jsx";
import Cta from "@/partials/Cta.astro";
import { getEntry } from "astro:content";

const homepage = await getEntry("homepage", "-index");
if (!homepage) throw new Error("Missing homepage content");
const { description, banner, preview, videos } = homepage.data;
const previewNav = ["Mission Command", "Readiness", "Opportunities", "Funding"];
---

<Base description={description}>
  <!-- Banner (Pinwheel banner layout, Retriever hero) -->
  <section id="product" class="hero-editorial banner relative isolate overflow-hidden pb-24 pt-16 sm:pt-24">
    <div class="aurora"></div>
    <div class="dotgrid hero-dots pointer-events-none absolute inset-0"></div>
    <div aria-hidden="true" class="hero-mark"></div>
    <div aria-hidden="true" class="hero-fade-bottom"></div>

    <div class="container relative z-10">
      <div class="row items-center">
        <div class="lg:col-7">
          <div class="max-w-2xl">
            <h1
              class="hero-title hero-rise text-balance text-[2.6rem] font-bold leading-[1.04] tracking-[-0.025em] sm:text-6xl lg:text-[4.25rem]"
              style="--d: 80ms"
            >
              {banner.title}<span class="hero-accent">{banner.title_accent}</span>
            </h1>
            <p class="hero-rise mt-8 max-w-xl text-lg sm:text-xl" style="--d: 160ms">
              {banner.content}
            </p>
            <div class="hero-rise mt-12 flex flex-wrap items-center gap-3" style="--d: 240ms">
              <a class="btn btn-primary btn-lift" href={banner.button.link}>
                {banner.button.label}
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"
                  ><path d="M5 12h14M13 6l6 6-6 6"></path></svg
                >
              </a>
              <button type="button" class="btn btn-outline-primary btn-lift" data-quick-open>
                {banner.quick_assessment_label}
              </button>
            </div>
            <p class="hero-rise mt-5 text-sm" style="--d: 300ms">{banner.audience}</p>
          </div>
        </div>
        <div class="mt-16 flex justify-center lg:col-5 lg:mt-0 lg:justify-end lg:pr-4">
          <VideoShowcase
            variant="device"
            src={banner.video.src}
            poster={banner.video.poster}
            label={banner.video.label}
            class="w-[min(19rem,76vw)]"
            maxTilt={7}
            revealAfter={600}
          />
        </div>
      </div>

      <!-- Dashboard preview: opens sign-in, as on the original site -->
      <a href={preview.link} class="relative mx-auto mt-24 block w-full max-w-6xl text-left" aria-label={preview.aria_label}>
        <div
          aria-hidden="true"
          class="absolute -top-8 left-1/2 -z-10 h-40 w-[85%] -translate-x-1/2 rounded-full bg-navy/20 blur-3xl lg:h-72"
        >
        </div>
        <div
          class="relative overflow-hidden rounded-2xl border border-navy/15 bg-white p-2 shadow-raised ring-4 ring-navy/5 dark:border-slate-700 dark:bg-[#161C27]"
        >
          <div class="overflow-hidden rounded-xl bg-page dark:bg-[#0C1017]">
            <div class="flex min-h-[22rem]">
              <aside
                class="hidden w-48 shrink-0 border-r border-line bg-soft p-3 text-xs leading-normal text-ink dark:border-slate-800 dark:bg-[#121722] dark:text-slate-100 sm:block"
              >
                <div class="mb-4 flex items-center gap-2 font-semibold">
                  <img src="/images/logo-mark.png" alt="" width="20" height="20" class="size-5 rounded-full object-cover" />
                  Retriever
                </div>
                {
                  previewNav.map((item, i) => (
                    <div
                      class:list={[
                        "px-2 py-1.5",
                        i === 0
                          ? "rounded-md bg-white font-medium dark:bg-white/10"
                          : "text-muted dark:text-slate-400",
                        { "mt-1": i === 1 },
                      ]}
                    >
                      {item}
                    </div>
                  ))
                }
              </aside>
              <DashboardPreview client:visible />
            </div>
          </div>
        </div>
      </a>
    </div>
  </section>

  <div aria-hidden="true" class="fade-to-navy"></div>

  <!-- Product videos -->
  <section id="videos" class="video-section glass-on-dark relative isolate overflow-hidden pb-24 pt-10 sm:pb-32 sm:pt-12">
    <div class="aurora aurora-video video-aurora-mask"></div>
    <div class="dotgrid video-aurora-mask pointer-events-none absolute inset-0"></div>
    <div class="container relative">
      <h2 class="text-center text-3xl font-semibold tracking-tight text-white sm:text-4xl">{videos.title}</h2>
      <VideoShowcase
        variant="wide"
        src={videos.video.src}
        poster={videos.video.poster}
        label={videos.video.label}
        class="mx-auto mt-14 w-full max-w-5xl"
        maxTilt={4}
      />
    </div>
  </section>

  <Cta />

  <QuickAssessmentLauncher client:load />
</Base>
