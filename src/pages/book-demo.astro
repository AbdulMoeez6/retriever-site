---
// Pinwheel contact-page layout (intro column + form column) in Retriever's dark "book a demo" styling.
// ?intent=pilot switches the copy and the HubSpot form to the Founding Partner Pilot request.
import LeadForm from "@/components/LeadForm.astro";
import OfferIntro from "@/components/OfferIntro.astro";
import OfferPoints from "@/components/OfferPoints.astro";
import Base from "@/layouts/Base.astro";
import { EMAIL_FIELD, NAME_FIELD, ORG_FIELD, POINTS, SLOT_CHIPS } from "@/lib/lead-fields";

const demo = {
  eyebrow: "Book a demo",
  title: "See Retriever on ",
  accent: "your technology.",
  line: "A short, guided walkthrough of evidence-gated readiness, opportunities and funding matches.",
};
const pilot = {
  eyebrow: "Founding Partner Pilot",
  title: "Request your ",
  accent: "pilot invite.",
  line: "The Founding Partner Pilot is invite only. Share a few details and we'll follow up.",
};
---

<Base title="Book a demo" description={demo.line}>
  <section class="bd-page relative isolate overflow-hidden" data-book-demo>
    <div class="bd-aurora" aria-hidden="true"></div>
    <div class="bd-grid" aria-hidden="true"></div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/20 to-transparent"
    >
    </div>

    <div class="container relative z-10 py-16 lg:py-24">
      <div class="row items-center">
        <div class="lg:col-6 xl:col-7">
          <div class="max-w-xl">
            <OfferIntro {...demo} variant="demo" />
            <OfferIntro {...pilot} variant="pilot" hidden />
            <OfferPoints points={POINTS} />
          </div>
        </div>
        <div class="mt-14 lg:col-6 lg:mt-0 xl:col-5">
          <div class="relative mx-auto max-w-[27rem]">
            <div
              aria-hidden="true"
              class="pointer-events-none absolute -inset-10 -z-10 rounded-[3rem] bg-[radial-gradient(closest-side,rgba(90,150,225,0.28),transparent)] blur-2xl"
            >
            </div>
            <LeadForm formKey="demo" fields={[NAME_FIELD, EMAIL_FIELD, ORG_FIELD]} chips={SLOT_CHIPS} cta="Book a demo" />
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // ?intent=pilot → Founding Partner Pilot copy, CTA and HubSpot form
  if (new URLSearchParams(window.location.search).get("intent") === "pilot") {
    const root = document.querySelector("[data-book-demo]");
    root?.querySelectorAll("[data-variant='demo'], [data-variant='pilot']").forEach((el) => {
      el.hidden = el.dataset.variant !== "pilot";
    });
    const form = root?.querySelector("[data-lead-form]");
    if (form) {
      form.dataset.formKey = "pilot";
      form.dataset.context = "Request: Founding Partner Pilot invite";
      const cta = form.querySelector("[data-cta]");
      if (cta) cta.textContent = "Request invite";
    }
  }
</script>
